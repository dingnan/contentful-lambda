{
  "name": "contentful-akamai-lambda",
  "version": "1.0.0",
  "description": "AWS Lambda: sync Contentful content to Akamai NetStorage",
  "scripts": {
    "build": "npm run build:webhook && npm run build:fetcher",
    "build:webhook": "esbuild src/contentful-webhook-receiver.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/contentful-webhook-receiver/index.js && zip -j dist/contentful-webhook-receiver/webhook.zip dist/contentful-webhook-receiver/index.js",
    "build:fetcher": "esbuild src/contentful-entry-fetcher.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/contentful-entry-fetcher/index.js && zip -j dist/contentful-entry-fetcher/fetcher.zip dist/contentful-entry-fetcher/index.js",
    "deploy:webhook": "aws lambda update-function-code --function-name webhook-handler --zip-file fileb://./dist/contentful-webhook-receiver/webhook.zip",
    "deploy:fetcher": "aws lambda update-function-code --function-name contentful-entry-fetcher --zip-file fileb://./dist/contentful-entry-fetcher/fetcher.zip",
    "deploy": "npm run deploy:webhook && npm run deploy:fetcher"
  },
  "dependencies": {
    "@aws-sdk/client-lambda": "^3.0.0",
    "@aws-sdk/client-s3": "^3.0.0",
    "contentful": "^11.7.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.162",
    "@types/node": "^25.9.3",
    "esbuild": "^0.28.1",
    "jest": "^29.0.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
